# Dev account — copy to tfvars/dev.tfvars and fill in real values.
# Deployment/bootstrap: README.md. Teardown: docs/teardown.md.

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

image_repository = "<account-id>.dkr.ecr.<region>.amazonaws.com/fortiaigate"

# ---------------------------------------------------------------------------
# Infrastructure
# ---------------------------------------------------------------------------

aws_region     = "us-east-1"
cluster_name   = "fortiaigate-dev"
image_tag      = "V8.0.2-build0055"
app_node_count = 1

# ---------------------------------------------------------------------------
# GPU support
# ---------------------------------------------------------------------------

gpu_enabled            = true
gpu_node_instance_type = "g5.2xlarge"
gpu_tuning_profile     = "auto" # Selects shared A10G settings for G5; no YAML overlay.
# Optional overrides; omit gpu_tuning to use the profile defaults.
# gpu_tuning = {
#   triton_memory_request = "12Gi"
#   triton_memory_limit   = "25Gi"
#   vllm_memory_request   = "8Gi"
#   vllm_memory_limit     = "24Gi"
#   vllm_max_num_seqs     = 64
# }

# ---------------------------------------------------------------------------
# Ingress
# ---------------------------------------------------------------------------

aws_load_balancer_controller_enabled = true
ingress_class                        = "alb"
# Public HTTPS example; replace the hostname and certificate ARN.
# For private HTTP evaluation, use examples/internal-alb/terraform.tfvars.
internal     = false
ingress_host = "fortiaigate.example.com"
ingress_annotations = {
  "kubernetes.io/ingress.class"                = "alb"
  "alb.ingress.kubernetes.io/scheme"           = "internet-facing"
  "alb.ingress.kubernetes.io/target-type"      = "ip"
  "alb.ingress.kubernetes.io/listen-ports"     = "[{\"HTTPS\":443}]"
  "alb.ingress.kubernetes.io/backend-protocol" = "HTTPS"
  "alb.ingress.kubernetes.io/certificate-arn"  = "arn:aws:acm:<region>:<account-id>:certificate/<id>"
}


# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------

storage_size  = "100Gi"
efs_encrypted = false

# ---------------------------------------------------------------------------
# Licenses
# ---------------------------------------------------------------------------
# Upload the deployment license in the WebUI after deployment (or use
# POST /api/v1/admin/licenses). No license tfvars or follow-up apply is needed.

# TLS: ALB frontend and pod web certificates are configured independently.
# acm_certificate_arn = "arn:aws:acm:<region>:<account-id>:certificate/<id>"
# tls_certificate_path = "/secure/fullchain.pem"
# tls_private_key_path = "/secure/private.key"
# tls_ca_certificate_path = "/secure/private-root-ca.pem"
# See docs/ingress-and-tls.md.
